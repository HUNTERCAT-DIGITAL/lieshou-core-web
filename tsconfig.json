{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@lieshoucloud/contract-api": ["../lieshou-contract-api/src"],
      "@lieshoucloud/contract-types": ["../lieshou-contract-types/src"],
      "@lieshoucloud/contract-types/*": ["../lieshou-contract-types/src/*"]
    }
  },
  "include": ["src"]
}
